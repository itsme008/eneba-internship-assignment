APP_NAME="Eneba Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eneba
DB_USERNAME=postgres
DB_PASSWORD=
# Production: Neon connection string with sslmode=require, supplied as a secret.
# DB_URL=postgresql://user:password@host/database?sslmode=require
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=eneba_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Transactional key delivery (Brevo HTTPS API). This does not enable password recovery.
ORDER_EMAIL_DRIVER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=sender@example.com
MAIL_FROM_NAME="Daraab's Marketplace Demo"
