{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "allowImportingTsExtensions": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
